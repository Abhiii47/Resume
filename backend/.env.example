# SmartResume Backend — Environment Variables
# Copy this to .env and fill in your actual values
# NEVER commit .env to version control

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Optional: override the derived resume encryption key used for DB-at-rest encryption
RESUME_ENCRYPTION_KEY=
# Optional: comma-separated emails allowed to see admin telemetry
ADMIN_EMAILS=admin@example.com

# --- Database (Neon PostgreSQL recommended for production) ---
# Local dev (SQLite — no setup needed):
DATABASE_URL=sqlite:///./smart_resume.db
# Production (Neon — get from https://console.neon.tech):
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# --- LLM Provider ---
# Options: groq | gemini (both used in fallback chain)
LLM_PROVIDER=groq

# Groq — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# --- Adzuna Job Discovery (Real-time worldwide jobs) ---
# Register at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
# Countries to query (ISO 2-letter, comma-separated)
ADZUNA_COUNTRIES=us,gb,in,de,fr,au,ca,nl,sg,br

# --- GitHub OAuth ---
# Create at: https://github.com/settings/developers → New OAuth App
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_STATE_TTL_SECONDS=600
FRONTEND_APP_URL=http://localhost:3000/dashboard

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGIN_REGEX=https://your-app\.vercel\.app

# --- Server ---
PORT=8000
