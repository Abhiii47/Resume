# SmartResume Backend — Environment Variables
# Copy this to .env and fill in your actual values
# NEVER commit .env to version control

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Local dev (SQLite — no setup needed):
DATABASE_URL=sqlite:///./smart_resume.db
# Production (Railway PostgreSQL — get from Railway dashboard):
# DATABASE_URL=postgresql://user:password@host:5432/database

# --- LLM Provider ---
# Options: groq | gemini
LLM_PROVIDER=groq

# Groq — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# --- GitHub OAuth ---
# Create at: https://github.com/settings/developers → New OAuth App
# Homepage URL: http://localhost:3000 (or your prod URL)
# Callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGIN_REGEX=https://your-app\.vercel\.app

# --- Server ---
PORT=8000
